# Copy to .env.local for local development. Never commit real secrets.
# Supabase Project URL (Project Settings -> API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Server-only secret/service-role key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-server-only-key"

# Secret used to authenticate scheduled hold cleanup requests.
CRON_SECRET="replace-with-a-long-random-secret"

# Protects POST /api/admin/inventory. Keep server-only.
HEPRABUS_ADMIN_TOKEN="replace-with-a-long-random-admin-token"

# Staff verification dashboard credentials. Configure strong unique values in deployment settings.
HEPRABUS_STAFF_USERNAME="operator"
HEPRABUS_STAFF_PASSWORD="replace-with-a-long-unique-password"
# Use at least 32 random characters. Example generation: openssl rand -base64 48
HEPRABUS_STAFF_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Razorpay test/live credentials. Keep all secrets server-only; never use NEXT_PUBLIC_ for secrets.
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-webhook-secret"
# Shopify storefront integration (never expose Admin API secrets to browser code)
# Example: your-store.myshopify.com (no https://)
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
# Configure only after creating the store
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
# Server-only Admin API token; never use a NEXT_PUBLIC_ prefix
SHOPIFY_ADMIN_ACCESS_TOKEN=""
# Server-only app secret used to verify Shopify webhook HMAC signatures
SHOPIFY_API_SECRET=""
