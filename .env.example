# Copy to .env.local for local development. Never commit real secrets.
# Supabase Project URL (Project Settings -> API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Server-only secret/service-role key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-server-only-key"

# Optional direct PostgreSQL connection for database tools/migrations.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a long random secret for server-side sessions.
AUTH_SECRET="replace-with-a-long-random-secret-before-use"

# Optional payment integration placeholders; configure only after choosing a provider.
# PAYMENT_PROVIDER=""
# PAYMENT_SECRET_KEY=""
# PAYMENT_WEBHOOK_SECRET=""
