# Copy to .env.local for local development. Never commit real secrets.
# Supabase Project URL (Project Settings -> API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Server-only secret/service-role key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-server-only-key"

# Secret used to authenticate scheduled hold cleanup requests. Generate a long random value.
CRON_SECRET="replace-with-a-long-random-secret"

# Optional direct PostgreSQL connection for database tools/migrations.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Protects POST /api/admin/inventory. Keep it server-only; send via x-heprabus-admin-token.\nHEPRABUS_ADMIN_TOKEN="replace-with-a-long-random-admin-token"\n\n# Generate a long random secret for server-side sessions.
AUTH_SECRET="replace-with-a-long-random-secret-before-use"

# Razorpay test/live credentials. Keep all secrets server-only; never use NEXT_PUBLIC_ for secret keys.
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-webhook-secret"
